# Copy to .env and fill in real values. Never commit .env.

# Signs Flask session cookies. Generate a fresh random value per environment:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# SQLAlchemy connection string.
#   Postgres: postgresql+psycopg2://user:password@host:5432/dbname
#   SQLite (local only): sqlite:///instance/app.db
DATABASE_URL=

# Google Gemini API key — https://aistudio.google.com/apikey
GOOGLE_GENAI_API_KEY=

# Read by app.py but not currently used by any code path. Leave blank.
LINKEDIN_TOKEN=
